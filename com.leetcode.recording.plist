<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>Label</key>
        <string>com.leetcode.recording</string>

        <key>ProgramArguments</key>
        <array>
            <string>/bin/bash</string>
            <!-- EDIT THIS PATH to match where your repo actually lives -->
            <string>/Users/alex/Desktop/2026-09-01-leetcode-recording/process-recordings.sh</string>
        </array>

        <!-- fires whenever the contents of this directory change -->
        <key>WatchPaths</key>
        <array>
            <string>/Users/alex/Desktop/2026-09-01-leetcode-recording</string>
        </array>

        <!-- safety net: also re-check every 5 minutes in case a WatchPaths event is missed -->
        <key>StartInterval</key>
        <integer>300</integer>

        <key>StandardOutPath</key>
        <string>/tmp/leetcode-recording.out</string>
        <key>StandardErrorPath</key>
        <string>/tmp/leetcode-recording.err</string>
    </dict>
</plist>